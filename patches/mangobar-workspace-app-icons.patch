-  char line[1024];
-  while (fgets(line, sizeof(line), f)) {
-    char *p = line;
-    while (*p == ' ' || *p == '\t')
-      p++;
-    if (*p == '\0' || *p == '#' || *p == ';' || *p == '\n')
-      continue; // empty line or comment
-    char *eq = strchr(p, '=');
-    if (!eq)
-      continue;
-    char *key_end = eq;
-    while (key_end > p && (key_end[-1] == ' ' || key_end[-1] == '\t'))
-      key_end--;
-    static const char key[] = "gtk-icon-theme-name";
-    if ((size_t)(key_end - p) != sizeof(key) - 1 ||
-        memcmp(p, key, sizeof(key) - 1) != 0)
-      continue;
-    char *v = eq + 1;
-    while (*v == ' ' || *v == '\t')
-      v++;
-    char *end = v + strlen(v);
-    while (end > v && (end[-1] == '\n' || end[-1] == '\r' ||
-                       end[-1] == ' ' || end[-1] == '\t'))
-      end--;
-    *end = '\0';
-    // Strip optional surrounding quotes
-    if (*v == '"' || *v == '\'') {
-      char quote = *v;
-      size_t l = strlen(v);
-      if (l >= 2 && v[l - 1] == quote) {
-        v++;
-        v[l - 2] = '\0';
-      }
-    }
-    size_t len = strlen(v);
-    if (len > 0) {
-      if (len >= outsz)
-        len = outsz - 1;
-      memcpy(out, v, len);
-      out[len] = '\0';
-      found = true;
-      break;
-    }
-  }
-  fclose(f);
-  return found;
-}
